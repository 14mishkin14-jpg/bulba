local function getRemotesContainer()

	local a =
		RS:FindFirstChild(
			"rbxts_include"
		)

	if not a then
		return nil
	end

	local b =
		a:FindFirstChild(
			"node_modules"
		)

	if not b then
		return nil
	end

	local c =
		b:FindFirstChild(
			"@rbxts"
		)

	if not c then
		return nil
	end

	local d =
		c:FindFirstChild(
			"remo"
		)

	if not d then
		return nil
	end

	local e =
		d:FindFirstChild(
			"src"
		)

	if not e then
		return nil
	end

	return e:FindFirstChild(
		"container"
	)
end

local function tryRemote(name)

	local container =
		getRemotesContainer()

	if not container then
		return nil
	end

	local direct =
		container:FindFirstChild(name)

	if direct
		and direct:IsA(
			"RemoteEvent"
		) then

		return direct
	end

	for _, obj in ipairs(
		container:GetDescendants()
	) do

		if obj.Name == name
			and obj:IsA(
				"RemoteEvent"
			) then

			return obj
		end
	end

	return nil
end

local function tryRemoteAny(name)
	local container = getRemotesContainer()
	if not container then return nil end

	local direct = container:FindFirstChild(name)
	if direct and (direct:IsA("RemoteEvent") or direct:IsA("RemoteFunction")) then
		return direct
	end

	for _, obj in ipairs(container:GetDescendants()) do
		if obj.Name == name and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
			return obj
		end
	end

	return nil
end

