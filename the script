local function refreshThemeVisuals()

    local oldAccent =
        Color3.fromRGB(255, 78, 78)

    local oldDark =
        Color3.fromRGB(150, 45, 45)

    for _, obj in ipairs(screen:GetDescendants()) do

        if obj:IsA("UIStroke") then
            if obj.Color == oldDark
                or obj.Color == oldAccent
            then
                obj.Color = C.accentD
            end
        elseif obj:IsA("ScrollingFrame") then
            if obj.ScrollBarImageColor3 == oldDark then
                obj.ScrollBarImageColor3 =
                    C.accentD
            end
        elseif obj:IsA("TextLabel")
            or obj:IsA("TextButton")
        then
            if obj.TextColor3 == oldAccent then
                obj.TextColor3 = C.accent
            end
        elseif obj:IsA("Frame") then
            if obj.BackgroundColor3 == oldAccent then
                obj.BackgroundColor3 = C.accent
            elseif obj.BackgroundColor3 == oldDark then
                obj.BackgroundColor3 = C.accentD
            end
        end
    end

    if tabButtons then
        for key, data in pairs(tabButtons) do
            if data and data.under then
                data.under.BackgroundColor3 =
                    C.accent
            end

            if data and data.btn then
                data.btn.TextColor3 =
                    key == S.tab
                    and C.accent
                    or C.textDim
            end
        end
    end
end

