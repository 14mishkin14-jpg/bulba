-- Persistent FOV loop. The game can overwrite Camera.FieldOfView;
-- this immediately restores the configured value and also survives
-- camera recreation / respawn.
local fovConnection = trackConnection(
    RunService.RenderStepped:Connect(function()
        if not runtimeAlive then
            return
        end

        local camera = workspace.CurrentCamera
        if camera then
            local target = math.clamp(
                tonumber(S.fov) or 70,
                50,
                120
            )

            if math.abs(camera.FieldOfView - target) > 0.05 then
                camera.FieldOfView = target
            end
        end
    end)
)

local function setFOV(value)
