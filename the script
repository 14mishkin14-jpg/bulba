--  MINIMIZE
-- ═══════════════════════════════════════════════════════════════════════

local minCircle = nil
local minCircleConn = nil

destroyMinCircle =
	function()

		if minCircleConn then

			pcall(function()
				minCircleConn:
					Disconnect()
			end)

			minCircleConn = nil
		end

		if minCircle then
			minCircle:Destroy()
			minCircle = nil
		end
	end

createMinCircle =
	function()

		if minCircle then
			return
		end

		minCircle =
			Instance.new(
				"TextButton"
			)

		minCircle.Name =
			"NexusMinCircle"

		minCircle.Size =
			UDim2.new(
				0,
				54,
				0,
				54
			)

		minCircle.Position =
			UDim2.new(
				0.5,
				-27,
				0,
				14
			)

		minCircle.BackgroundColor3 =
			C.accent

		minCircle.Text =
			"N"

		minCircle.TextColor3 =
			Color3.fromRGB(
				255,
				255,
				255
			)

		minCircle.TextSize = 22
		minCircle.Font = FONT_B

		minCircle.BorderSizePixel = 0
		minCircle.AutoButtonColor = false

		minCircle.ZIndex = 20

		minCircle.Parent =
			screen

		corner(
			minCircle,
			27
		)

		stroke(
			minCircle,
			C.accentD,
			2
		)

		local dragging = false
		local dragStart
		local startPos
		local moved = false

		trackConnection(
			minCircle.InputBegan:
				Connect(function(input)

				if
					input.UserInputType
					== Enum.UserInputType.MouseButton1

					or

					input.UserInputType
					== Enum.UserInputType.Touch
				then

					dragging = true
					moved = false

					dragStart =
						input.Position

					startPos =
						minCircle.Position
				end

			end)
		)

		trackConnection(
			minCircle.InputEnded:
				Connect(function(input)

				if
					input.UserInputType
					== Enum.UserInputType.MouseButton1

					or

					input.UserInputType
					== Enum.UserInputType.Touch
				then

					dragging = false

					if not moved then
						showUI()
					end
				end

			end)
		)

		minCircleConn =
			trackConnection(
				UserInputService
					.InputChanged:
					Connect(function(input)

					if
						dragging
						and
						(
							input.UserInputType
							== Enum.UserInputType.MouseMovement

							or

							input.UserInputType
							== Enum.UserInputType.Touch
						)
					then

						local delta =
							input.Position
							- dragStart

						if
							delta.Magnitude
							> 4
						then

							moved = true
						end

						minCircle.Position =
							UDim2.new(
								startPos.X.Scale,
								startPos.X.Offset
									+ delta.X,

								startPos.Y.Scale,
								startPos.Y.Offset
									+ delta.Y
							)
					end

				end)
			)
	end

showUI =
	function()

		main.Visible = true

		destroyMinCircle()
	end

hideUI =
	function()

		main.Visible = false

		createMinCircle()
	end

toggleUI =
	function()

		if main.Visible then
			hideUI()
		else
			showUI()
		end
	end

-- ═══════════════════════════════════════════════════════════════════════
--  WINDOW DRAG
-- ═══════════════════════════════════════════════════════════════════════

do

	local dragging = false
	local dragStart
	local startPos

	trackConnection(
		topbar.InputBegan:
			Connect(function(input)

				if
					input.UserInputType
					== Enum.UserInputType.MouseButton1
				then

					dragging = true

					dragStart =
						input.Position

					startPos =
						main.Position

					input.Changed:
						Connect(function()

						if
							input.UserInputState
							== Enum.UserInputState.End
						then

							dragging = false
						end

					end)
				end

			end)
	)

	trackConnection(
		UserInputService.InputChanged:
			Connect(function(input)

			if
				dragging
				and
				input.UserInputType
					== Enum.UserInputType.MouseMovement
			then

				local d =
					input.Position
					- dragStart

				main.Position =
					UDim2.new(
						startPos.X.Scale,
						startPos.X.Offset
							+ d.X,

						startPos.Y.Scale,
						startPos.Y.Offset
							+ d.Y
					)
			end

		end)
	)
end

-- ═══════════════════════════════════════════════════════════════════════
--  HOTKEYS
-- ═══════════════════════════════════════════════════════════════════════

local function textboxFocused()

	return
		UserInputService:GetFocusedTextBox()
		~= nil
end

local function hotkeyReady(key)

	local now =
		os.clock()

	if
		(
			now
			- (
				lastHotkeyTime[key]
				or 0
			)
		)
		<
		HOTKEY_DEBOUNCE
	then

		return false
	end

	lastHotkeyTime[key] =
		now

	return true
end

trackConnection(
	UserInputService.InputBegan:
		Connect(function(input,gp)

		if not runtimeAlive then
			return
		end

		if gp then
			return
		end

		if textboxFocused() then
			return
		end

        local configuredMenuKey =
            keyCodeFromName(
                S.menuBind
            )

        if
            input.KeyCode
            == configuredMenuKey
        then

            toggleUI()

            return
        end

		if
			input.KeyCode
			== Enum.KeyCode.R
		then

			if not hotkeyReady("R") then
				return
			end

			if running.roll then
				stopRoll()
			else
				startRoll()
			end

			return
		end

		if
			input.KeyCode
			== Enum.KeyCode.B
		then

			if not hotkeyReady("B") then
				return
			end

			if running.buy then
				stopBuy()
			else
				startBuy()
			end

			return
		end

        if
            input.KeyCode
            == Enum.KeyCode.S
        then

            if S.fly then
                return
            end

            if not hotkeyReady("S") then
                return
            end

            setSellEnabled(
                not running.sell,
                "hotkey"
            )

            return
        end

	end)
)

