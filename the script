local function findMyRollMachine()

	local plots =
		workspace:FindFirstChild(
			"plots"
		)

	if not plots then
		return nil,
			"no plots folder"
	end

	if
		S.myPlot
		and S.myPlot >= 1
		and S.myPlot <= 6
	then

		local p =
			plots:FindFirstChild(
				"Plot_" .. S.myPlot
			)

		if p then

			local rm =
				p:FindFirstChild(
					"roll-machine",
					true
				)

			if rm then
				return rm,
					"manual"
			end
		end

		return nil,
			"manual plot not found"
	end

	local char =
		LP.Character

	if not char then
		return nil,
			"no char"
	end

	local root =
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil,
			"no root"
	end

	local origin =
		root.Position

	local best = nil
	local bestDist =
		math.huge

	for _,p in ipairs(
		plots:GetChildren()
	) do

		local rm =
			p:FindFirstChild(
				"roll-machine",
				true
			)

		if rm then

			local slot1 =
				rm:FindFirstChild(
					"slot1",
					true
				)

			local anchor =
				slot1
				and slot1:FindFirstChild(
					"anchor",
					true
				)

			if anchor
				and anchor:IsA(
					"BasePart"
				) then

				local d =
					(
						anchor.Position
						- origin
					).Magnitude

				if d < bestDist then
					bestDist = d
					best = rm
				end
			end
		end
	end

	if best
		and bestDist < 300 then

		return best,
			("auto (%.0f studs)")
			:format(
				bestDist
			)
	end

	return nil,
		(
			"no plot within 300 (closest %.0f)"
		):format(
			bestDist
		)
end

local function getSlotItem(
	slotInst
)

	if not slotInst then
		return nil
	end

	local ok,result =
		pcall(function()

			local item =
				slotInst:FindFirstChild(
					"item"
				)

			if
				item
				and item:IsA(
					"ObjectValue"
				)
				and item.Value
			then

				return item.Value.Name
			end

			return nil
		end)

	if ok then
		return result
	end

	return nil
end

