local function fmtTime(sec)

	sec =
		math.floor(sec)

	local m =
		math.floor(
			sec / 60
		)

	local s =
		sec % 60

	return (
		"%d:%02d"
	):format(
		m,
		s
	)
end

local function refreshStatus()

	if not runtimeAlive then
		return
	end

	local parts = {}

	if running.sell then
		table.insert(
			parts,
			"SELL"
		)
	end

	if running.roll then
		table.insert(
			parts,
			"ROLL"
		)
	end

	if running.buy then
		table.insert(
			parts,
			"BUY"
		)
	end

	if #parts == 0 then

		setStatus(
			(
				"idle · sold:%d rolls:%d buys:%d skips:%d"
			):format(
				stats.sells,
				stats.rolls,
				stats.buys,
				stats.skips
			),
			C.textDim
		)

		return
	end

	local t =
		stats.startTime > 0
		and fmtTime(
			tick()
			- stats.startTime
		)
		or "0:00"

	setStatus(
		(
			"%s · sold:%d rolls:%d buys:%d · %s"
		):format(
			table.concat(
				parts,
				" + "
			),
			stats.sells,
			stats.rolls,
			stats.buys,
			t
		),
		C.ok
	)
end

local function performRoll()

    if rollBusy then
        return false,
            "roll busy"
    end

    rollBusy = true

    local ok,success,reason =
        xpcall(
            function()

                local rm =
                    findMyRollMachine()

                if not rm then
                    return false,
                        "roll machine not found"
                end

                local prompt =
                    findRollPrompt(
                        rm
                    )

                if not prompt then
                    return false,
                        "roll prompt not found"
                end

                local activated =
                    triggerPrompt(
                        prompt
                    )

                if activated then
                    stats.rolls += 1
                    lastRollActivity = tick()
                    return true,
                        "prompt"
                end

                return false,
                    "prompt trigger failed"

            end,
            debug.traceback
        )

    rollBusy = false

    if not ok then
        return false,
            tostring(success)
    end

    return
        success == true,
        reason
end

