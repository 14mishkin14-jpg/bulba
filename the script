--  AUTO BUY
--
--  IMPORTANT:
--  THERE IS NO performRoll() CALL HERE.
--  AUTO BUY ONLY READS SLOTS AND SENDS PURCHASE REQUESTS.
-- ═══════════════════════════════════════════════════════════════════════

local function normalizeCandidate(text)
    if type(text) ~= "string" then
        return nil
    end

    local s = text:lower()
    s = s:gsub("[^%w%s%-]", " ")
    s = s:gsub("%s+", " ")
    s = s:gsub("^%s+", "")
    s = s:gsub("%s+$", "")
    return s
end

local ITEM_LOOKUP = {}
for _, item in ipairs(ALL) do
    ITEM_LOOKUP[item.id] = {
        id = item.id,
        display = idToDisplay(item.id):lower(),
        material = item.mat:lower(),
        cat = item.cat:lower()
    }
end

local function detectSlotItemId(slotInst)
    if not slotInst then
        return nil
    end

    local candidates = {}

    local function addCandidate(v)
        if typeof(v) == "Instance" then
            candidates[#candidates + 1] = v.Name
            candidates[#candidates + 1] = v:GetFullName()
        elseif type(v) == "string" then
            candidates[#candidates + 1] = v
        end
    end

    local function scanAttributes(obj)
        local attrs = obj:GetAttributes()
        for key, value in pairs(attrs) do
            local lk = tostring(key):lower()
            if string.find(lk, "part", 1, true)
                or string.find(lk, "item", 1, true)
                or lk == "id"
                or string.find(lk, "name", 1, true)
            then
                addCandidate(value)
            end
        end
    end

    scanAttributes(slotInst)

    for _, obj in ipairs(slotInst:GetDescendants()) do
        scanAttributes(obj)

        if obj:IsA("StringValue") then
            addCandidate(obj.Value)
        elseif obj:IsA("ObjectValue") and obj.Value then
            addCandidate(obj.Value)
        elseif obj:IsA("Model") or obj:IsA("BasePart") then
            addCandidate(obj.Name)
        elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
            addCandidate(obj.Text)
        end
    end

    for _, raw in ipairs(candidates) do
        local c = normalizeCandidate(raw)
        if c then
            for id, info in pairs(ITEM_LOOKUP) do
                local nid = normalizeCandidate(id)
                if c == nid
                    or c == normalizeCandidate(info.display)
                    or string.find(c, nid, 1, true)
                    or string.find(c, normalizeCandidate(info.display), 1, true)
                then
                    return id
                end
            end
        end
    end

    return nil
end

local function findPurchasePrompt(slotInst)
    if not slotInst then
        return nil
    end

    for _, obj in ipairs(slotInst:GetDescendants()) do
        if obj:IsA("ProximityPrompt")
            and obj.Enabled ~= false
            and obj.ActionText == "Purchase"
        then
            return obj
        end
    end

    return nil
end

local function autoBuyPass(
	selectedItems
)

	local rm = findMyRollMachine()

	if not rm then
		return 0
	end

	local selectedSlots = getSelectedSlots()

	if #selectedSlots == 0 then
		return 0
	end

	local ready = {}

	-- Collect every ready Purchase prompt first.
	-- There is intentionally no per-slot wait here.
	for _, slotNum in ipairs(selectedSlots) do

		if not runtimeAlive or not running.buy then
			break
		end

		local slotInst = rm:FindFirstChild("slot" .. slotNum, true)

		if slotInst then
			local prompt = findPurchasePrompt(slotInst)

			if prompt then
				local itemId = detectSlotItemId(slotInst)
				local shouldBuy =
					(itemId and selectedItems[itemId] == true)
					or (itemId == nil and S.buyUnknown)

				if shouldBuy then
					ready[#ready + 1] = {
						slot = slotNum,
						prompt = prompt,
						itemId = itemId,
					}
				else
					stats.skips += 1
				end
			end
		end
	end

	if #ready == 0 then
		return 0
	end

	-- Trigger every ready Purchase prompt concurrently.
	-- triggerPrompt prefers fireproximityprompt when available,
	-- so zero-hold prompts are handled immediately.
	for _, entry in ipairs(ready) do
		task.spawn(function()
			if not runtimeAlive or not running.buy then
				return
			end

			local ok = triggerPrompt(entry.prompt)

			if ok then
				stats.buys += 1
				lastBuyActivity = tick()
			end
		end)
	end

	return #ready
end


