-- ═══════════════════════════════════════════════════════════════════════
--  WATCHDOG
-- ═══════════════════════════════════════════════════════════════════════

task.spawn(function()

	while runtimeAlive do

		task.wait(
			5
		)

		if not runtimeAlive then
			break
		end

		local now =
			tick()

		if running.roll then

			if
				lastRollActivity > 0
				and
				(
					now
					- lastRollActivity
				) > 20
			then

				refreshRemotes()
			end
		end

		if running.buy then

			if
				lastBuyActivity > 0
				and
				(
					now
					- lastBuyActivity
				) > 30
			then

				-- Buy watchdog ONLY refreshes BUY remote.
				-- It does NOT start Auto Roll.
				refreshRemotes()
			end
		end

		if running.sell then

			if not remoteAlive(
				sellEvent
			) then

				refreshRemotes()
			end
		end
	end
end)

