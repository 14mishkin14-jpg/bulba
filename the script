local function findRollPrompt(
    rollMachine
)

    if not rollMachine then
        return nil
    end

    local lever = rollMachine:FindFirstChild("lever", true)

    if lever then
        for _, obj in ipairs(lever:GetDescendants()) do
            if obj:IsA("ProximityPrompt")
                and obj.Enabled ~= false
            then
                if obj.ActionText == "Roll" then
                    return obj
                end
            end
        end
    end

    for _,obj in ipairs(
        rollMachine:GetDescendants()
    ) do
        if obj:IsA("ProximityPrompt")
            and obj.Enabled ~= false
            and obj.ActionText == "Roll"
        then
            return obj
        end
    end

    return nil
end

local function triggerPrompt(
	prompt
)

	if not prompt then
		return false
	end

	if not prompt.Parent then
		return false
	end

	if
		prompt:IsA(
			"ProximityPrompt"
		)
		and not prompt.Enabled
	then

		return false
	end

	if fireproximityprompt then

		local ok =
			pcall(function()

				fireproximityprompt(
					prompt
				)

			end)

		if ok then
			return true
		end
	end

	local ok =
		pcall(function()

			prompt:InputHoldBegin()

			local hold =
				tonumber(
					prompt.HoldDuration
				)
				or 0

			if hold > 0 then

				task.wait(
					hold + 0.08
				)

			else

				task.wait(
					0.08
				)
			end

			prompt:InputHoldEnd()

		end)

	return ok
end

