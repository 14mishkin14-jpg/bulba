		myPlot = 0,

        fly = false,
        flySpeed = 50,
        fov = 70,
        menuBind = "RightShift",
        accentName = "red",
        notifications = true,
        buyUnknown = false,
	}

	if isfile
		and isfile(CFG_FILE) then

		local ok,d =
			pcall(function()

				return HttpService:JSONDecode(
					readfile(
						CFG_FILE
					)
				)

			end)

		if ok
			and type(d) == "table" then

			for k,v in pairs(d) do
				def[k] = v
			end

			if d.buySlot
				and not d.buySlots then

				def.buySlots = {
					[tonumber(
						d.buySlot
					)] = true
				}

				def.buySlot = nil
			end

			def.afkSell = nil
		end
	end

	if type(
		def.buySlots
	) == "table" then

		local fixed = {}

		for k,v in pairs(
			def.buySlots
		) do

			local n =
				tonumber(k)

			if
				n
				and n >= 1
				and n <= 5
				and v
			then

				fixed[n] = true
			end
		end

		def.buySlots = fixed
	end

	if
		type(
			def.buySlots
		) ~= "table"
		or
		next(
			def.buySlots
		) == nil
	then

		def.buySlots = {
			[1] = true
		}
	end

	if def.gameId == 1046 then
		def.gameId = 1045
	end

	return def
end

