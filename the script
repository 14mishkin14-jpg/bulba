local function sellPass(
	workerId
)

	local char =
		LP.Character

	if not char then
		return
	end

	local hum =
		char:FindFirstChildOfClass(
			"Humanoid"
		)

	local backpack =
		LP:FindFirstChild(
			"Backpack"
		)

	if not hum
		or not backpack then

		return
	end

	for _,tool in ipairs(
		backpack:GetChildren()
	) do

		if
			not runtimeAlive
			or not running.sell
			or workerId ~= sellRunId
		then
			break
		end

		if tool:IsA("Tool") then

			local id =
				displayToId(
					tool.Name
				)

			if
				id
				and S.sell[id] == true
			then

				hum:EquipTool(
					tool
				)

				task.wait(
					math.max(
						0.03,
						tonumber(
							S.sellEquipDelay
						)
						or 0.15
					)
				)

				if not remoteAlive(
					sellEvent
				) then

					refreshRemotes()
				end

				if remoteAlive(
					sellEvent
				) then

					local ok =
						pcall(function()

							sellEvent:
								FireServer()

						end)

					if ok then
						stats.sells += 1
					end
				end

				task.wait(
					math.max(
						0.03,
						tonumber(
							S.sellDelay
						)
						or 0.30
					)
				)
			end
		end
	end
end

local function beginSellWorker(
	workerId
)

	task.spawn(function()

		while
			runtimeAlive
			and running.sell
			and workerId == sellRunId
		do

			local ok,err =
				xpcall(
					function()
						sellPass(
							workerId
						)
					end,
					debug.traceback
				)

			if not ok then

				warn(
					"[nexus] SELL worker recovered:\n"
					.. tostring(
						err
					)
				)

				task.wait(
					0.5
				)
			end

			if
				runtimeAlive
				and running.sell
				and workerId == sellRunId
			then

				task.wait(
					0.30
				)
			end
		end
	end)
end

setSellEnabled =
	function(
		enabled,
		source
	)

		if not runtimeAlive then
			return
		end

		local now =
			os.clock()

		if
			source ~= "shutdown"
			and
			(
				now
				- lastSellToggle
			)
			< SELL_TOGGLE_DEBOUNCE
		then

			return
		end

		if running.sell == enabled then
			return
		end

		lastSellToggle =
			now

		if enabled then

			running.sell = true

			sellRunId += 1

			local workerId =
				sellRunId

			if stats.startTime == 0 then
				stats.startTime =
					tick()
			end

			refreshRemotes()

			if not remoteAlive(
				sellEvent
			) then

				running.sell = false

				toast(
					"sell remote not found!",
					C.err
				)

				updateToggleVisual(
					"sell",
					false
				)

				return
			end

			toast(
				"Auto Sell ON",
				C.ok
			)

			if S.sounds then
				beep(
					9118823102
				)
			end

			updateToggleVisual(
				"sell",
				true
			)

			beginSellWorker(
				workerId
			)

		else

			sellRunId += 1

			running.sell = false

			toast(
				"Auto Sell OFF",
				C.textDim
			)

			if S.sounds then
				beep(
