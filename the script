--  RUNTIME SHUTDOWN
-- ═══════════════════════════════════════════════════════════════════════

local shuttingDown = false

_G.NexusRuntime = {

	id = runtimeId,

	shutdown = function()

		if shuttingDown then
			return
		end

		shuttingDown = true

		runtimeAlive = false

		running.roll = false
		running.buy = false
		running.sell = false

		sellRunId += 1

		pcall(function()
			stopSniffer()
		end)

		pcall(function()
			destroyMinCircle()
		end)

		disconnectAllConnections()

		pcall(function()

			if
				screen
				and screen.Parent
			then

				screen:Destroy()
			end

		end)
	end
}

