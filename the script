-- ═══════════════════════════════════════════════════════════════════════

local function hardResetOldNexus()

	-- Shut down a previous modern runtime.
	pcall(function()
		local oldRuntime = rawget(_G, "NexusRuntime")

		if oldRuntime and oldRuntime.shutdown then
			oldRuntime.shutdown()
		end
	end)

	-- Remove old GUI copies.
	pcall(function()
		local Players = game:GetService("Players")
		local LP = Players.LocalPlayer

		for _, parent in ipairs({
			game:GetService("CoreGui"),
			LP and LP:FindFirstChild("PlayerGui")
		}) do
			if parent then
				local old =
					parent:FindFirstChild(
						"NexusAutoSellBuy"
					)

				if old then
					old:Destroy()
				end
			end
		end
	end)

	-- Try to remove stale old InputBegan connections.
	pcall(function()

		if not getconnections then
			return
		end

		local UIS =
			game:GetService(
				"UserInputService"
			)

		for _, connection in ipairs(
			getconnections(UIS.InputBegan)
		) do

			local fn = connection.Function

			if fn and getupvalues then

				local ok, ups =
					pcall(
						getupvalues,
						fn
					)

				if ok and type(ups) == "table" then

					local looksOld = false

					for _, value in pairs(ups) do

						if typeof(value) == "Instance" then
							if value.Name ==
								"NexusAutoSellBuy" then

								looksOld = true
								break
							end
						end
					end

					if looksOld then
						pcall(function()
							connection:Disconnect()
						end)
					end
				end
			end
		end
	end)
end

hardResetOldNexus()

