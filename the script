local function idToDisplay(id)
	local mat, kind =
		id:match(
			"^(.+)%-(.+)$"
		)

	if not mat or not kind then
		return id
	end

	local k =
		KIND_REV[kind]

	if not k then
		return id
	end

	return
		mat:sub(1,1):upper()
		.. mat:sub(2)
		.. " "
		.. k
end

local function displayToId(name)
	local mat, kind =
		name:match(
			"^(%S+)%s+(%S+)$"
		)

	if not mat or not kind then
		return nil
	end

	local k =
		KIND_FWD[kind]

	if not k then
		return nil
	end

	return
		mat:lower()
		.. "-"
		.. k
end

