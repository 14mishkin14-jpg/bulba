    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = label
    lbl.Parent = row

    local valueLbl =
        Instance.new("TextLabel")

    valueLbl.Size =
        UDim2.new(
            0,
            50,
            0,
            18
        )

    valueLbl.Position =
        UDim2.new(
            1,
            -58,
            0,
            3
        )

    valueLbl.BackgroundTransparency = 1
    valueLbl.TextColor3 = C.accent
    valueLbl.TextSize = 10
    valueLbl.Font = FONT_B
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.Text = tostring(getValue())
    valueLbl.Parent = row

    local bar =
        Instance.new("Frame")

    bar.Size =
        UDim2.new(
            1,
            -16,
            0,
            6
        )

    bar.Position =
        UDim2.new(
            0,
            8,
            1,
            -13
        )

    bar.BackgroundColor3 = C.box
    bar.BorderSizePixel = 0
    bar.Parent = row

    corner(bar, 4)

    local fill =
        Instance.new("Frame")

    fill.BackgroundColor3 = C.accent
    fill.BorderSizePixel = 0
    fill.Parent = bar

    corner(fill, 4)

    local draggingSlider = false

    local function updateFromX(x)

        local alpha =
            math.clamp(
                (x - bar.AbsolutePosition.X)
                / math.max(1, bar.AbsoluteSize.X),
                0,
                1
            )

        local raw =
            minValue
            + (maxValue - minValue) * alpha

        if step and step > 0 then
            raw =
                math.floor(
                    raw / step + 0.5
                ) * step
        end

        raw =
            math.clamp(
                raw,
                minValue,
                maxValue
            )

        setValue(raw)
        persist()

        local v =
            tonumber(
                getValue()
            )
            or minValue

        local pct =
            math.clamp(
                (v - minValue)
                / (maxValue - minValue),
                0,
                1
            )

        fill.Size =
            UDim2.new(
                pct,
                0,
                1,
                0
            )

        valueLbl.Text =
            tostring(
                math.floor(v)
            )
    end

    local function refresh()

        local v =
            tonumber(getValue())
            or minValue

        local pct =
            math.clamp(
                (v - minValue)
                / (maxValue - minValue),
                0,
                1
            )

        fill.Size =
            UDim2.new(
                pct,
                0,
                1,
                0
            )

        valueLbl.Text =
            tostring(
                math.floor(v)
            )
    end

    trackConnection(
        bar.InputBegan:
            Connect(function(input)

                if
                    input.UserInputType
                    == Enum.UserInputType.MouseButton1
                then
                    draggingSlider = true
                    updateFromX(input.Position.X)
                end
            end)
    )

    trackConnection(
        UserInputService.InputChanged:
            Connect(function(input)

                if
                    draggingSlider
                    and
                    input.UserInputType
                    == Enum.UserInputType.MouseMovement
                then
                    updateFromX(input.Position.X)
                end
            end)
    )

    trackConnection(
        UserInputService.InputEnded:
            Connect(function(input)

                if
                    input.UserInputType
                    == Enum.UserInputType.MouseButton1
                then
                    draggingSlider = false
                end
            end)
    )

    refresh()

    return row
end

